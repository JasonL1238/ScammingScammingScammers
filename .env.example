# Copy to .env and fill in. NEVER commit .env — see docs/secrets.md.
# In production these are injected at container start from a SOPS-encrypted
# file or Doppler; the repo only ever contains this template.

# --- Twilio (inbound-only subaccount; outbound voice/SMS MUST be disabled) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_HONEYPOT_NUMBER=+15555550100
# Public base URL Twilio reaches us on (tunnel URL in dev).
PUBLIC_BASE_URL=https://example.invalid
# Random path token appended to the media-stream WS URL.
MEDIA_STREAM_PATH_TOKEN=change-me

# --- Anthropic ---
# Left unset is fine if you've run `ant auth login` — the SDK resolves a profile.
ANTHROPIC_API_KEY=
# Both optional. Empty uses the defaults in ssscammers/agent/llm.py (claude-sonnet-5,
# effort low). ANTHROPIC_MODEL exists so a retired or regionally unavailable model is a
# restart rather than a redeploy — but the request shape there is specific to Sonnet 5,
# so read that module before pointing this at an older model.
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=

# --- Speech ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# Not used yet — no code path selects ElevenLabs. See Settings.elevenlabs_api_key.
ELEVENLABS_API_KEY=

# --- Storage ---
DATABASE_URL=postgresql://ssscammers:ssscammers@localhost:5432/ssscammers
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ssscammers-audio

# --- Notifications ---
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# --- Owner identity: feeds the G-3 PII denylist. Real values, never spoken. ---
# Comma-separated. The output filter blocks any of these appearing in agent speech.
# Placeholders only: the real values are themselves secrets and live in the secret
# store per docs/secrets.md. Git history retains the values committed before this
# file was scrubbed.
OWNER_PII_DENYLIST=Firstname,Lastname,owner@example.com
OWNER_REAL_NUMBER=+15555550199
# Spoken passphrase that lets the owner/family escape the persona to voicemail.
OWNER_SAFEWORD=pineapple

# --- Operational caps (see plan: C10, C11, G-14..G-16) ---
MAX_CONCURRENT_CALLS=5
HARD_CALL_CAP_SECONDS=5400
SOFT_CALL_CAP_SECONDS=3600
DEAD_AIR_HANGUP_SECONDS=60
PROBATION_SECONDS=30
PROBATION_HARD_COMMIT_SECONDS=90
# Where today's minute/spend totals are kept. MUST be on a volume that survives a
# restart, or every daily cap below resets whenever the process bounces.
DAILY_LEDGER_PATH=/var/lib/ssscammers/daily_ledger.json
# Cost estimate driving DAILY_SPEND_CAP_USD. Not a measurement - reconcile with invoices.
ESTIMATED_USD_PER_CALL_MINUTE=0.05
DAILY_MINUTES_CAP=360
DAILY_SPEND_CAP_USD=50
REPEAT_CALLER_DAILY_CAP=5

# --- Ingress (see ssscammers/agent/webhooks.py) ---
# G-2. Pre-rendered recorded-line notice, played by Twilio before the agent speaks.
# Leave empty and a fixed synthesised line is spoken instead: degraded, never absent.
NOTICE_AUDIO_URL=
# Which character answers.
DEFAULT_PERSONA=marjorie
# Ceiling on a single voicemail message.
VOICEMAIL_MAX_SECONDS=120
